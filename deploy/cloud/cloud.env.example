# HeroMarket cloud – settings for deploy/cloud/docker-compose.yml. Copy to deploy/cloud/.env on the
# server (never commit it) and fill in every value. See .docs/CLOUD_DEPLOYMENT.md.

# The name the phones open, pointing (DNS A record) at this server, e.g. shop.example.com
HEROMARKET_DOMAIN=
# Let's Encrypt writes here before a certificate expires.
HEROMARKET_ACME_EMAIL=

# Database password: long and random, URL-safe characters only:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Server secret (at least 32 characters). Keep a copy with the owner, apart from the server: a
# restore on a new server needs the same one.
#   openssl rand -base64 48
HEROMARKET_SECRET=
# The store's time zone (the copy holds the shop's local times).
HEROMARKET_TIMEZONE=Africa/Cairo

# Nightly encrypted copies: the owner's age PUBLIC key (age1…). The private key stays with the
# owner, never on this server. Made once with:  age-keygen -o heromarket-backup-key.txt
BACKUP_RECIPIENT=
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# Optional: a second copy off this server (S3-compatible storage; a key limited to one bucket,
# allowed to write but not to delete). Leave BACKUP_OFFSITE empty to keep copies on this server only.
#   BACKUP_OFFSITE=offsite:<bucket>/heromarket
#   OFFSITE_PROVIDER=Cloudflare              (or Other for Backblaze B2's S3 endpoint)
#   OFFSITE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   OFFSITE_ACCESS_KEY_ID=
#   OFFSITE_SECRET_ACCESS_KEY=
BACKUP_OFFSITE=
