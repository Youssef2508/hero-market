# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────
# HeroMarket cloud – the internet way in to one store (Phase 2, D-101, D-105).
#
# The same HeroMarket service in its "cloud" role, plus the browser build of the same screens.
# Runs as the unprivileged `node` user and contains no secrets: the database URL and the server
# secret come from the environment or Docker secrets (*_FILE variables).
#
#   docker compose -f deploy/cloud/docker-compose.yml up -d     (see .docs/CLOUD_DEPLOYMENT.md)
# ─────────────────────────────────────────────────────────────

# 1. The browser build (needs the build tools; nothing from this stage but out/web is kept).
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS web
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm_config_fund=false npm_config_update_notifier=false
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY vite.web.config.mjs ./
COPY scripts/vite-csp.mjs ./scripts/
COPY resources ./resources
COPY src/renderer ./src/renderer
COPY src/shared ./src/shared
RUN npm run build:web

# 2. The service.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

ENV NODE_ENV=production \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    npm_config_fund=false \
    npm_config_update_notifier=false \
    HOST=0.0.0.0 \
    PORT=8787 \
    HEROMARKET_WEB_ROOT=/app/web

WORKDIR /app
RUN chown node:node /app
USER node

# Runtime dependencies only, exactly as locked; install scripts are not run.
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --chown=node:node src/server ./src/server
COPY --chown=node:node src/shared ./src/shared
COPY --chown=node:node --from=web /build/out/web ./web

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "src/server/cli.js", "health"]
CMD ["node", "src/server/cli.js", "cloud"]
