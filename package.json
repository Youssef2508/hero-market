{
  "name": "heromarket-pos",
  "version": "1.3.0",
  "description": "HeroMarket POS – supermarket point of sale and management system (Electron + React)",
  "main": "./out/main/index.js",
  "author": "HeroMarket",
  "homepage": "https://github.com/Youssef2508/hero-market",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check src tests scripts",
    "lint": "eslint --cache .",
    "test": "node tests/run-all.js",
    "test:unit": "node tests/run-all.js unit",
    "test:service": "node tests/run-all.js service",
    "db:legacy-fixture": "node scripts/init-dev-db.js",
    "db:import-sqlite": "node scripts/import-sqlite.js",
    "icons": "electron scripts/generate-icons.js",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true });\"",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run clean && npm run build && electron-builder --dir",
    "build:win": "npm run clean && npm run build && electron-builder --win",
    "build:mac": "npm run clean && npm run build && electron-builder --mac",
    "build:linux": "npm run clean && npm run build && electron-builder --linux",
    "pg:dev": "node scripts/pg-dev.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/cairo": "^5.2.5",
    "fastify": "^5.12.7",
    "lucide-react": "^1.25.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  }
}
