# HeroMarket – environment variables. Copy to .env (never commit .env) and fill in the values.
# Docker Compose reads .env automatically; the desktop app does not need any of these.

# ── Multi-till server (docker compose up -d) ───────────────────────────────────────────────
# Database password: long and random, URL-safe characters only, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# Server secret (≥ 32 characters). Keys the PIN lookup: keep it with your database backups;
# a restore on a new server needs the same secret, or every user logs in once to re-key their PIN.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HEROMARKET_SECRET=
# Store time zone (receipts, shifts and "today" in reports use local time).
HEROMARKET_TIMEZONE=Africa/Cairo
# Address the HTTPS proxy listens on: 127.0.0.1 (this machine only) or the server's LAN address.
HEROMARKET_BIND=127.0.0.1
# Names / addresses the tills connect to (certificate names), comma separated, e.g. 192.168.1.10, heromarket.local
HEROMARKET_TLS_NAMES=localhost, 127.0.0.1
# The address tills use (they connect by IP, so no server name is sent): usually the server's LAN IP.
HEROMARKET_TLS_DEFAULT_NAME=127.0.0.1
# Optional: a fixed first-run setup code instead of the random one printed in the server log.
# HEROMARKET_SETUP_CODE=
# HEROMARKET_LOG_LEVEL=info

# ── Development (npm run dev) ──────────────────────────────────────────────────────────────
# Database name in the npm run pg:dev cluster (default heromarket), e.g. a disposable QA copy.
# HEROMARKET_DB_NAME=heromarket_qa
# Run the app on its own managed local PostgreSQL instead of the pg:dev cluster.
# HEROMARKET_LOCAL_DB=1
# Use another data folder (QA of first-run and upgrade flows on a copy of a store's data).
# HEROMARKET_USER_DATA=C:\path\to\qa-folder
# Connect a development session as a cashier terminal to a running server.
# HEROMARKET_SERVER_URL=https://127.0.0.1:8443
# Root certificate the till pins for that server (root.crt exported from the proxy).
# HEROMARKET_SERVER_CA=C:path	ooot.crt

# ── Tests ──────────────────────────────────────────────────────────────────────────────────
# PostgreSQL for the service suites (each test file creates and drops its own database).
# Without it, npm test uses the npm run pg:dev cluster, or fails.
# HEROMARKET_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
