# HeroMarket POS – optional development/test environment variables.
# These are read from the process environment (set them in your shell or CI job);
# the app does not load a .env file. No secrets are required to run the app.
# Never commit real paths to production data or any credentials.

# Point a development session at a disposable SQLite database (ignored when packaged).
# HEROMARKET_DB_PATH=C:\path\to\qa.db

# Tests: copy this database instead of bootstrapping a fresh one.
# TEST_SOURCE_DB=C:\path\to\copy-of-market_unified.db

# Tests: force a fresh bootstrap even when an installed database exists.
# TEST_FRESH_DB=1

# Non-Windows: path to the sqlite3 CLI (defaults to `sqlite3` on PATH).
# SQLITE3_BIN=/usr/bin/sqlite3
